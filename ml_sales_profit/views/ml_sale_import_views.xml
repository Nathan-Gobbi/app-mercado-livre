<odoo>
    <record id="ml_sale_import_view_list" model="ir.ui.view">
        <field name="name">ml.sale.import.list</field>
        <field name="model">ml.sale.import</field>
        <field name="arch" type="xml">
            <list string="Sales Imports">
                <field name="currency_id" column_invisible="True" />
                <field name="name" />
                <field name="date_from" optional="hide" />
                <field name="date_to" optional="hide" />
                <field name="total_units" sum="Total" />
                <field name="total_revenue" sum="Total" />
                <field name="total_gross_profit" sum="Total" optional="hide" />
                <field name="total_net_profit" sum="Total" />
                <field name="net_margin" />
                <field
                    name="not_found_count"
                    decoration-warning="not_found_count &gt; 0"
                    optional="show"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </list>
        </field>
    </record>

    <record id="ml_sale_import_view_form" model="ir.ui.view">
        <field name="name">ml.sale.import.form</field>
        <field name="model">ml.sale.import</field>
        <field name="arch" type="xml">
            <form string="Sales Import">
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_download_report"
                        string="Download Excel Report"
                        type="object"
                        class="btn-primary"
                        icon="fa-download"
                        invisible="state != 'done'"
                    />
                    <button
                        name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'done'"
                        confirm="The sales of this import will be removed. Continue?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            invisible="state != 'done'"
                        >
                            <field name="line_count" widget="statinfo" string="Sales" />
                        </button>
                    </div>
                    <field name="currency_id" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True" />
                        </h1>
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not_found_count == 0"
                    >
                        <field name="not_found_count" class="oe_inline" /> sales have
                        no listing registered for their SKU and type, so their profit
                        is zero. Register the listings and process the import again.
                    </div>
                    <group>
                        <group name="file" string="File">
                            <field
                                name="file"
                                filename="file_name"
                                readonly="state != 'draft'"
                            />
                            <field name="file_name" invisible="True" />
                            <field name="date_from" invisible="state == 'draft'" />
                            <field name="date_to" invisible="state == 'draft'" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group
                            name="totals"
                            string="Summary"
                            invisible="state == 'draft'"
                        >
                            <field name="total_units" />
                            <field name="total_revenue" />
                            <field name="total_gross_profit" />
                            <field name="gross_margin" />
                            <field name="total_net_profit" />
                            <field name="net_margin" />
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Sales" name="sales">
                            <field name="line_ids">
                                <list decoration-warning="profit_status == 'not_found'">
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="sale_date" />
                                    <field name="sale_number" optional="hide" />
                                    <field name="sku" />
                                    <field name="title" />
                                    <field name="variation" optional="show" />
                                    <field name="listing_type" />
                                    <field name="ml_status" optional="hide" />
                                    <field name="units" sum="Total" />
                                    <field name="revenue" sum="Total" />
                                    <field name="net_profit" sum="Total" />
                                    <field name="net_margin" />
                                    <field
                                        name="profit_status"
                                        widget="badge"
                                        decoration-success="profit_status == 'ok'"
                                        decoration-warning="profit_status == 'not_found'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="ml_sale_import_view_search" model="ir.ui.view">
        <field name="name">ml.sale.import.search</field>
        <field name="model">ml.sale.import</field>
        <field name="arch" type="xml">
            <search string="Sales Imports">
                <field name="name" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="done"
                    string="Processed"
                    domain="[('state', '=', 'done')]"
                />
                <separator />
                <filter
                    name="with_not_found"
                    string="With Sales Without Listing"
                    domain="[('not_found_count', '&gt;', 0)]"
                />
            </search>
        </field>
    </record>

    <record id="ml_sale_import_action" model="ir.actions.act_window">
        <field name="name">Sales Imports</field>
        <field name="res_model">ml.sale.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import a sales report</p>
            <p>
                Download the sales report from Mercado Livre, upload it here and
                click <b>Process</b> to see how much you sold and how much you
                earned with each product.
            </p>
        </field>
    </record>
</odoo>
