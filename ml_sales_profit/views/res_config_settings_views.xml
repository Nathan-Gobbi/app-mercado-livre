<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.ml_sales_profit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="ML Sales Profit"
                    string="ML Sales Profit"
                    name="ml_sales_profit"
                    groups="ml_sales_profit.group_ml_manager"
                >
                    <block title="Profit" name="ml_sales_profit_profit">
                        <setting
                            string="Tax Rate (%)"
                            help="Percentage of the sale price paid as tax. Used to compute the tax and the profit of every listing."
                        >
                            <field name="ml_tax_rate" />
                        </setting>
                    </block>
                    <block title="Mercado Livre API" name="ml_sales_profit_api">
                        <setting
                            string="API synchronization"
                            help="Synchronize paid and cancelled Mercado Livre orders every 15 minutes."
                        >
                            <field name="ml_api_enabled" />
                        </setting>
                        <setting string="Application credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="ml_api_client_id"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="ml_api_client_id" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="ml_api_client_secret"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field
                                        name="ml_api_client_secret"
                                        password="True"
                                    />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="ml_api_redirect_uri"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field
                                        name="ml_api_redirect_uri"
                                        placeholder="http://localhost:18069/ml/oauth/callback"
                                    />
                                </div>
                                <div class="mt16">
                                    <button
                                        name="action_ml_authorize"
                                        type="object"
                                        string="Connect Mercado Livre"
                                        class="btn-primary"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting string="Connected seller">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="ml_api_nickname"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="ml_api_nickname" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="ml_api_seller_id"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="ml_api_seller_id" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="ml_api_last_sync_at"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="ml_api_last_sync_at" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Initial synchronization period"
                            help="Number of days imported on the first synchronization. Mercado Livre keeps searchable orders for up to 12 months."
                        >
                            <field name="ml_api_initial_sync_days" />
                        </setting>
                        <setting string="Synchronize now">
                            <button
                                name="action_ml_sync_orders"
                                type="object"
                                string="Synchronize Orders"
                                class="btn-secondary"
                                invisible="not ml_api_seller_id"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ml_sales_profit', 'bin_size': False}</field>
    </record>
</odoo>
