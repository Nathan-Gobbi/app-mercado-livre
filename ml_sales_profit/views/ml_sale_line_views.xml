<odoo>
    <record id="ml_sale_line_view_list" model="ir.ui.view">
        <field name="name">ml.sale.line.list</field>
        <field name="model">ml.sale.line</field>
        <field name="arch" type="xml">
            <list
                string="Sales"
                create="0"
                delete="0"
                decoration-warning="profit_status == 'not_found'"
            >
                <field name="currency_id" column_invisible="True" />
                <field name="sale_date" />
                <field name="sale_number" optional="hide" />
                <field name="sku" />
                <field name="title" />
                <field name="variation" optional="show" />
                <field name="listing_type" />
                <field name="ml_status" optional="hide" />
                <field name="units" sum="Total" />
                <field name="revenue" sum="Total" />
                <field name="unit_tax" optional="hide" />
                <field name="unit_gross_profit" optional="hide" />
                <field name="unit_net_profit" optional="hide" />
                <field name="gross_profit" sum="Total" optional="show" />
                <field name="gross_margin" optional="hide" />
                <field name="net_profit" sum="Total" />
                <field name="net_margin" />
                <field
                    name="profit_status"
                    widget="badge"
                    decoration-success="profit_status == 'ok'"
                    decoration-warning="profit_status == 'not_found'"
                />
                <field name="revenue_origin" optional="hide" />
            </list>
        </field>
    </record>

    <record id="ml_sale_line_view_form" model="ir.ui.view">
        <field name="name">ml.sale.line.form</field>
        <field name="model">ml.sale.line</field>
        <field name="arch" type="xml">
            <form string="Sale" create="0" edit="0" delete="0">
                <sheet>
                    <field name="currency_id" invisible="True" />
                    <div class="oe_title">
                        <label for="sale_number" />
                        <h1>
                            <field name="sale_number" />
                        </h1>
                    </div>
                    <group>
                        <group name="sale" string="Sale">
                            <field name="sale_date" />
                            <field name="ml_status" />
                            <field name="sku" />
                            <field name="title" />
                            <field name="variation" />
                            <field name="listing_type" />
                            <field name="listing_id" />
                            <field name="import_ids" widget="many2many_tags" />
                        </group>
                        <group name="values" string="Values">
                            <field name="units" />
                            <field name="revenue" />
                            <field name="revenue_origin" />
                            <field name="unit_tax" />
                            <field name="unit_gross_profit" />
                            <field name="unit_net_profit" />
                            <field name="gross_profit" />
                            <field name="gross_margin" />
                            <field name="net_profit" />
                            <field name="net_margin" />
                            <field name="profit_status" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ml_sale_line_view_pivot" model="ir.ui.view">
        <field name="name">ml.sale.line.pivot</field>
        <field name="model">ml.sale.line</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis" sample="1">
                <field name="sku" type="row" />
                <field name="sale_date" interval="month" type="col" />
                <field name="units" type="measure" />
                <field name="revenue" type="measure" />
                <field name="net_profit" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="ml_sale_line_view_graph" model="ir.ui.view">
        <field name="name">ml.sale.line.graph</field>
        <field name="model">ml.sale.line</field>
        <field name="arch" type="xml">
            <graph string="Sales Analysis" type="bar" order="desc" sample="1">
                <field name="sku" />
                <field name="net_profit" type="measure" />
            </graph>
        </field>
    </record>

    <record id="ml_sale_line_view_search" model="ir.ui.view">
        <field name="name">ml.sale.line.search</field>
        <field name="model">ml.sale.line</field>
        <field name="arch" type="xml">
            <search string="Sales">
                <field name="sku" />
                <field name="title" />
                <field name="product_tmpl_id" />
                <field name="sale_number" />
                <field name="import_ids" />
                <filter
                    name="not_found"
                    string="Without Listing"
                    domain="[('profit_status', '=', 'not_found')]"
                />
                <filter
                    name="loss"
                    string="Negative Profit"
                    domain="[('net_profit', '&lt;', 0)]"
                />
                <separator />
                <filter
                    name="premium"
                    string="Premium"
                    domain="[('listing_type', '=', 'premium')]"
                />
                <filter
                    name="classic"
                    string="Classic"
                    domain="[('listing_type', '=', 'classic')]"
                />
                <separator />
                <filter name="filter_sale_date" string="Sale Date" date="sale_date" />
                <group>
                    <filter
                        name="group_sku"
                        string="SKU"
                        context="{'group_by': 'sku'}"
                    />
                    <filter
                        name="group_product"
                        string="Product"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                    <filter
                        name="group_type"
                        string="Listing Type"
                        context="{'group_by': 'listing_type'}"
                    />
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'sale_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="ml_sale_line_action" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">ml.sale.line</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sales yet</p>
            <p>
                Process a sales report in <b>Imports &gt; Sales</b> to analyze
                revenue and profit by product, listing type and month.
            </p>
        </field>
    </record>
</odoo>
