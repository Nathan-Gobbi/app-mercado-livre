<odoo>
    <!-- Statement imports -->
    <record id="ml_statement_import_view_list" model="ir.ui.view">
        <field name="name">ml.statement.import.list</field>
        <field name="model">ml.statement.import</field>
        <field name="arch" type="xml">
            <list string="Statement Imports">
                <field name="currency_id" column_invisible="True" />
                <field name="name" />
                <field name="initial_balance" optional="show" />
                <field name="credits" optional="show" />
                <field name="debits" optional="show" />
                <field name="final_balance" optional="show" />
                <field name="line_count" optional="hide" />
                <field name="total_outflow" sum="Total" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </list>
        </field>
    </record>

    <record id="ml_statement_import_view_form" model="ir.ui.view">
        <field name="name">ml.statement.import.form</field>
        <field name="model">ml.statement.import</field>
        <field name="arch" type="xml">
            <form string="Statement Import">
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_download_report"
                        string="Download Excel Report"
                        type="object"
                        class="btn-primary"
                        icon="fa-download"
                        invisible="state != 'done'"
                    />
                    <button
                        name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'done'"
                        confirm="The outflows of this import and their notes will be removed. Continue?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-arrow-circle-o-down"
                            invisible="state != 'done'"
                        >
                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Outflows"
                            />
                        </button>
                    </div>
                    <field name="currency_id" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True" />
                        </h1>
                    </div>
                    <group>
                        <group name="file" string="File">
                            <field
                                name="file"
                                filename="file_name"
                                readonly="state != 'draft'"
                            />
                            <field name="file_name" invisible="True" />
                            <field name="date_from" invisible="state == 'draft'" />
                            <field name="date_to" invisible="state == 'draft'" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group
                            name="summary"
                            string="Statement Summary"
                            invisible="state == 'draft'"
                        >
                            <field name="initial_balance" />
                            <field name="credits" />
                            <field name="debits" />
                            <field name="final_balance" />
                            <field name="total_outflow" />
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Outflows" name="outflows">
                            <field
                                name="line_ids"
                                options="{'link': false, 'unlink': false}"
                            >
                                <list editable="bottom" create="0" delete="0">
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="date" />
                                    <field name="transaction_type" />
                                    <field name="reference_id" optional="hide" />
                                    <field name="amount" sum="Total" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="ml_statement_import_view_search" model="ir.ui.view">
        <field name="name">ml.statement.import.search</field>
        <field name="model">ml.statement.import</field>
        <field name="arch" type="xml">
            <search string="Statement Imports">
                <field name="name" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="done"
                    string="Processed"
                    domain="[('state', '=', 'done')]"
                />
            </search>
        </field>
    </record>

    <record id="ml_statement_import_action" model="ir.actions.act_window">
        <field name="name">Statement Imports</field>
        <field name="res_model">ml.statement.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import an account statement</p>
            <p>
                Download the account statement from Mercado Pago, upload it here
                and click <b>Process</b> to list the money that went out.
            </p>
        </field>
    </record>

    <!-- Statement outflows -->
    <record id="ml_statement_line_view_list" model="ir.ui.view">
        <field name="name">ml.statement.line.list</field>
        <field name="model">ml.statement.line</field>
        <field name="arch" type="xml">
            <list string="Outflows" editable="bottom" create="0" delete="0">
                <field name="currency_id" column_invisible="True" />
                <field name="date" />
                <field name="transaction_type" />
                <field name="reference_id" optional="hide" />
                <field name="amount" sum="Total" />
                <field name="note" />
            </list>
        </field>
    </record>

    <record id="ml_statement_line_view_pivot" model="ir.ui.view">
        <field name="name">ml.statement.line.pivot</field>
        <field name="model">ml.statement.line</field>
        <field name="arch" type="xml">
            <pivot string="Outflows Analysis" sample="1">
                <field name="transaction_type" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="outflow_amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="ml_statement_line_view_graph" model="ir.ui.view">
        <field name="name">ml.statement.line.graph</field>
        <field name="model">ml.statement.line</field>
        <field name="arch" type="xml">
            <graph string="Outflows Analysis" type="pie" sample="1">
                <field name="transaction_type" />
                <field name="outflow_amount" type="measure" />
            </graph>
        </field>
    </record>

    <record id="ml_statement_line_view_search" model="ir.ui.view">
        <field name="name">ml.statement.line.search</field>
        <field name="model">ml.statement.line</field>
        <field name="arch" type="xml">
            <search string="Outflows">
                <field name="transaction_type" />
                <field name="reference_id" />
                <field name="note" />
                <field name="import_ids" />
                <filter
                    name="with_note"
                    string="With Note"
                    domain="[('note', '!=', False)]"
                />
                <filter
                    name="without_note"
                    string="Without Note"
                    domain="[('note', '=', False)]"
                />
                <separator />
                <filter name="filter_date" string="Date" date="date" />
                <group>
                    <filter
                        name="group_type"
                        string="Transaction Type"
                        context="{'group_by': 'transaction_type'}"
                    />
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="ml_statement_line_action" model="ir.actions.act_window">
        <field name="name">Outflows Analysis</field>
        <field name="res_model">ml.statement.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No outflows yet</p>
            <p>
                Process an account statement in <b>Imports &gt; Statements</b> to
                analyze where your money went.
            </p>
        </field>
    </record>

    <!-- Ignored transaction types -->
    <record id="ml_statement_excluded_type_view_list" model="ir.ui.view">
        <field name="name">ml.statement.excluded.type.list</field>
        <field name="model">ml.statement.excluded.type</field>
        <field name="arch" type="xml">
            <list string="Ignored Transaction Types" editable="bottom">
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="ml_statement_excluded_type_action" model="ir.actions.act_window">
        <field name="name">Ignored Transaction Types</field>
        <field name="res_model">ml.statement.excluded.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ignored types</p>
            <p>
                Outflows with these transaction types are left out when a
                statement is processed.
            </p>
        </field>
    </record>
</odoo>
