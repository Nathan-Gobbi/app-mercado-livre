<odoo>
    <record id="action_purchase_requirement_report" model="ir.actions.report">
        <field name="name">Purchase Requirement by Supplier</field>
        <field name="model">purchase.requirement.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ml_sales_profit.purchase_requirement_report</field>
        <field name="report_file">ml_sales_profit.purchase_requirement_report</field>
        <field
            name="print_report_name"
        >'Purchase requirement - %s' % object.report_date</field>
    </record>

    <template id="purchase_requirement_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-foreach="wizard._supplier_groups()" t-as="supplier_group">
                    <t t-set="supplier" t-value="supplier_group[0]" />
                    <t t-set="lines" t-value="supplier_group[1]" />
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Purchase Requirement</h2>
                            <div class="row mb-4">
                                <div class="col-8">
                                    <strong>Supplier:</strong>
                                    <span t-field="supplier.display_name" />
                                    <div t-if="supplier.street">
                                        <span t-field="supplier.contact_address" />
                                    </div>
                                    <div t-if="supplier.phone">
                                        <strong>Phone:</strong>
                                        <span t-field="supplier.phone" />
                                    </div>
                                    <div t-if="supplier.email">
                                        <strong>Email:</strong>
                                        <span t-field="supplier.email" />
                                    </div>
                                </div>
                                <div class="col-4 text-end">
                                    <strong>Date:</strong>
                                    <span t-field="wizard.report_date" />
                                </div>
                            </div>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Product</th>
                                        <th class="text-end">Current</th>
                                        <th class="text-end">Minimum</th>
                                        <th class="text-end">Purchase</th>
                                        <th class="text-end">Unit Cost</th>
                                        <th class="text-end">Estimated Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="lines" t-as="line">
                                        <td>
                                            <span
                                                t-field="line.product_id.default_code"
                                            />
                                        </td>
                                        <td>
                                            <span t-field="line.product_id.name" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.current_stock_qty" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.minimum_stock_qty" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.unit_cost" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.subtotal" />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6" class="text-end">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong
                                                t-out="sum(lines.mapped('subtotal'))"
                                                t-options="{'widget': 'monetary', 'display_currency': lines[0].currency_id}"
                                            />
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
