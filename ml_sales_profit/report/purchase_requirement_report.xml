<odoo>
    <record id="action_purchase_requirement_report" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">purchase.requirement.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ml_sales_profit.purchase_requirement_report</field>
        <field name="report_file">ml_sales_profit.purchase_requirement_report</field>
        <field name="print_report_name">'Purchase order - %s' % object.name</field>
    </record>

    <template id="purchase_requirement_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-set="supplier" t-value="order.supplier_id" />
                <t t-set="lines" t-value="order.line_ids" />
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Purchase Order <span t-field="order.name" /></h2>
                        <div class="row mb-4">
                            <div class="col-8">
                                <strong>Supplier:</strong>
                                <span t-if="supplier" t-field="supplier.display_name" />
                                <span t-else="">Without supplier</span>
                                <div t-if="supplier and supplier.street">
                                    <span t-field="supplier.contact_address" />
                                </div>
                                <div t-if="supplier and supplier.phone">
                                    <strong>Phone:</strong>
                                    <span t-field="supplier.phone" />
                                </div>
                                <div t-if="supplier and supplier.email">
                                    <strong>Email:</strong>
                                    <span t-field="supplier.email" />
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <strong>Date:</strong>
                                <span t-field="order.order_date" />
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Product</th>
                                    <th class="text-end">Current</th>
                                    <th class="text-end">Minimum</th>
                                    <th class="text-end">Purchase</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Estimated Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td>
                                        <span t-field="line.product_id.default_code" />
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.name" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.current_stock_qty" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.minimum_stock_qty" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.unit_cost" />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.subtotal" />
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="text-end">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong t-field="order.amount_total" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
