<odoo>
    <record id="purchase_requirement_order_create_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.requirement.order.create.wizard.form</field>
        <field name="model">purchase.requirement.order.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Purchase Order">
                <group>
                    <field
                        name="supplier_id"
                        placeholder="Leave empty to create without a supplier"
                    />
                </group>
                <footer>
                    <button
                        name="action_create_order"
                        string="Create Order"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="purchase_requirement_report_wizard_action"
        model="ir.actions.act_window"
    >
        <field name="name">New Purchase Order</field>
        <field name="res_model">purchase.requirement.order.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
