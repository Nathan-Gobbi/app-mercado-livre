<odoo>
    <record id="purchase_requirement_report_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.requirement.report.wizard.form</field>
        <field name="model">purchase.requirement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Requirement">
                <group>
                    <field name="report_date" />
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="currency_id" column_invisible="True" />
                        <field name="supplier_id" force_save="1" />
                        <field name="product_id" force_save="1" />
                        <field name="current_stock_qty" force_save="1" />
                        <field name="minimum_stock_qty" force_save="1" />
                        <field name="quantity" force_save="1" />
                        <field name="unit_cost" force_save="1" />
                        <field name="subtotal" sum="Estimated Total" />
                    </list>
                </field>
                <group
                    string="Products Without Supplier"
                    invisible="not missing_supplier_product_ids"
                >
                    <field
                        name="missing_supplier_product_ids"
                        widget="many2many_tags"
                        nolabel="1"
                    />
                    <div class="text-warning">
                        These products are below minimum stock but will not appear in
                        the PDF until a preferred supplier is assigned.
                    </div>
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        string="Generate PDF"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="purchase_requirement_report_wizard_action"
        model="ir.actions.act_window"
    >
        <field name="name">Purchase Requirement</field>
        <field name="res_model">purchase.requirement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
