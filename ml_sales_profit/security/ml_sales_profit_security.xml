<odoo>
    <record id="module_category_ml_sales_profit" model="ir.module.category">
        <field name="name">Mercado Livre Sales Profit</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_ml_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_ml_sales_profit" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>

    <record id="ml_listing_company_rule" model="ir.rule">
        <field name="name">Mercado Livre listing: multi-company</field>
        <field name="model_id" ref="model_ml_listing" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ml_sale_import_company_rule" model="ir.rule">
        <field name="name">Mercado Livre sales import: multi-company</field>
        <field name="model_id" ref="model_ml_sale_import" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ml_sale_line_company_rule" model="ir.rule">
        <field name="name">Mercado Livre sale: multi-company</field>
        <field name="model_id" ref="model_ml_sale_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ml_statement_import_company_rule" model="ir.rule">
        <field name="name">Mercado Livre statement import: multi-company</field>
        <field name="model_id" ref="model_ml_statement_import" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ml_statement_line_company_rule" model="ir.rule">
        <field name="name">Mercado Livre statement outflow: multi-company</field>
        <field name="model_id" ref="model_ml_statement_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
